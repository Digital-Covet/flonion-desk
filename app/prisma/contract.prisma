// use prisma-next
// Contract inferred from the live database schema. Edit as needed, then run `prisma contract emit`.

model Business {
  id                String             @id(map: "business_pkey")
  userId            String
  placeId           String?
  logo              String?
  name              String
  phone             String?
  address           String?
  createdAt         Timestamp(3)       @default(now())
  updatedAt         Timestamp(3)
  keywords          String?
  reviewLink        String?
  reviewLinks       Jsonb?
  sector            String?
  username          String?
  description       String?
  rating            Float?
  reviewCount       Int?
  bookingEndTime    String             @default("17:00")
  bookingStartTime  String             @default("14:00")
  slotDuration      Int                @default(30)
  timezone          String             @default("Asia/Kolkata")
  workingDays       String             @default("1,2,3,4,5")
  workingEndTime    String             @default("18:00")
  workingStartTime  String             @default("09:00")
  qrScanCount       Int                @default(0)
  availabilitySlots AvailabilitySlot[]
  businessContacts  BusinessContact[]
  favoritePartners  FavoritePartner[]
  invitations       Invitation[]
  joinRequests      JoinRequest[]
  meetingRequests   MeetingRequest[]
  projects          Project[]
  services          Service[]
  tasks             Task[]
  teamMeetings      TeamMeeting[]
  users             User[]
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "business_userId_fkey")

  @@index([rating, createdAt], map: "business_rating_createdAt_idx")
  @@index([sector], map: "business_sector_idx")
  @@unique([userId], map: "business_userId_key")
  @@index([username], map: "business_username_key", unique: true)
  @@map("business")
}

model User {
  id                      String           @id(map: "user_pkey")
  name                    String
  email                   String
  emailVerified           Boolean          @default(false)
  image                   String?
  createdAt               Timestamp(3)     @default(now())
  updatedAt               Timestamp(3)
  twoFactorEnabled        Boolean?         @default(false)
  onboardingCompleted     Boolean          @default(false)
  businessId              String?
  role                    String           @default("member")
  accounts                Account[]
  business                Business?
  feedbacks               Feedback[]
  googleToken             GoogleToken?
  invitations             Invitation[]
  meetingRequests         MeetingRequest[]
  sessions                Session[]
  sharedReviews           SharedReview[]
  tasks                   Task[]
  twoFactors              TwoFactor[]
  joinRequests            JoinRequest[]    @relation(name: "join_request_reviewedById_fkey")
  joinRequestsJoinRequest JoinRequest[]    @relation(name: "join_request_userId_fkey")
  businessBusiness        Business?        @relation(fields: [businessId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "user_businessId_fkey")

  @@index([businessId], map: "user_businessId_idx")
  @@index([email], map: "user_email_key", unique: true)
  @@map("user")
}

model Account {
  id                    String        @id(map: "account_pkey")
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  Timestamp(3)?
  refreshTokenExpiresAt Timestamp(3)?
  scope                 String?
  password              String?
  createdAt             Timestamp(3)  @default(now())
  updatedAt             Timestamp(3)
  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "account_userId_fkey")

  @@index([userId], map: "account_userId_idx")
  @@map("account")
}

model AvailabilitySlot {
  id             String          @id(map: "availability_slot_pkey")
  businessId     String
  date           Timestamp(3)
  startTime      String
  endTime        String
  isBooked       Boolean         @default(false)
  createdAt      Timestamp(3)    @default(now())
  title          String?
  meetingRequest MeetingRequest?
  business       Business        @relation(fields: [businessId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "availability_slot_businessId_fkey", index: false)

  @@index([businessId, date], map: "availability_slot_businessId_date_idx")
  @@index([businessId, date, startTime], map: "availability_slot_businessId_date_startTime_key", unique: true)
  @@map("availability_slot")
}

model BusinessContact {
  id         String       @id(map: "business_contact_pkey")
  businessId String
  name       String
  role       String
  avatarUrl  String?
  email      String?
  position   Int          @default(0)
  createdAt  Timestamp(3) @default(now())
  updatedAt  Timestamp(3)
  business   Business     @relation(fields: [businessId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "business_contact_businessId_fkey")

  @@index([businessId], map: "business_contact_businessId_idx")
  @@map("business_contact")
}

model FavoritePartner {
  id         String       @id(map: "favorite_partner_pkey")
  userId     String
  businessId String
  createdAt  Timestamp(3) @default(now())
  business   Business     @relation(fields: [businessId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "favorite_partner_businessId_fkey")

  @@index([businessId], map: "favorite_partner_businessId_idx")
  @@index([userId, businessId], map: "favorite_partner_userId_businessId_key", unique: true)
  @@index([userId], map: "favorite_partner_userId_idx")
  @@map("favorite_partner")
}

model Feedback {
  id        String       @id(map: "feedback_pkey")
  userId    String
  name      String
  email     String
  category  String
  rating    Int
  message   String
  createdAt Timestamp(3) @default(now())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "feedback_userId_fkey")

  @@index([userId], map: "feedback_userId_idx")
  @@map("feedback")
}

model GoogleToken {
  id           String       @id(map: "google_token_pkey")
  userId       String
  accessToken  String
  refreshToken String
  expiresAt    Timestamp(3)
  tokenType    String       @default("Bearer")
  createdAt    Timestamp(3) @default(now())
  updatedAt    Timestamp(3)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "google_token_userId_fkey")

  @@unique([userId], map: "google_token_userId_key")
  @@map("google_token")
}

model Invitation {
  id          String       @id(map: "invitation_pkey")
  email       String
  businessId  String
  role        String       @default("member")
  invitedById String
  token       String
  status      String       @default("pending")
  expiresAt   Timestamp(3)
  createdAt   Timestamp(3) @default(now())
  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "invitation_businessId_fkey")
  invitedBy   User         @relation(fields: [invitedById], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "invitation_invitedById_fkey", index: false)

  @@index([businessId], map: "invitation_businessId_idx")
  @@index([email], map: "invitation_email_idx")
  @@index([token], map: "invitation_token_key", unique: true)
  @@map("invitation")
}

model JoinRequest {
  id                         String        @id(map: "join_request_pkey")
  businessId                 String
  userId                     String
  pendingUserId              String?
  message                    String?
  status                     String        @default("pending")
  grantedRole                String?
  consentDeleteOwnedBusiness Boolean       @default(false)
  reviewedById               String?
  reviewedAt                 Timestamp(3)?
  createdAt                  Timestamp(3)  @default(now())
  updatedAt                  Timestamp(3)
  business                   Business      @relation(fields: [businessId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "join_request_businessId_fkey", index: false)
  reviewedBy                 User?         @relation(name: "join_request_reviewedById_fkey", fields: [reviewedById], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "join_request_reviewedById_fkey", index: false)
  user                       User          @relation(name: "join_request_userId_fkey", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "join_request_userId_fkey", index: false)

  @@index([businessId, status], map: "join_request_businessId_status_idx")
  @@index([pendingUserId], map: "join_request_pendingUserId_key", unique: true)
  @@index([userId, createdAt], map: "join_request_userId_createdAt_idx")
  @@map("join_request")
}

model MeetingRequest {
  id          String           @id(map: "meeting_request_pkey")
  slotId      String
  businessId  String
  requesterId String?
  status      String           @default("pending")
  message     String?
  createdAt   Timestamp(3)     @default(now())
  updatedAt   Timestamp(3)
  meetSpaceId String?
  meetUri     String?
  guestEmail  String?
  guestName   String?
  guestPhone  String?
  business    Business         @relation(fields: [businessId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "meeting_request_businessId_fkey", index: false)
  requester   User?            @relation(fields: [requesterId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "meeting_request_requesterId_fkey")
  slot        AvailabilitySlot @relation(fields: [slotId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "meeting_request_slotId_fkey")

  @@index([businessId, status], map: "meeting_request_businessId_status_idx")
  @@index([requesterId], map: "meeting_request_requesterId_idx")
  @@unique([slotId], map: "meeting_request_slotId_key")
  @@map("meeting_request")
}

model PrismaMigrations {
  id                VarChar(36)  @id(map: "_prisma_migrations_pkey")
  checksum          VarChar(64)
  finishedAt        Timestamptz? @map("finished_at")
  migrationName     VarChar(255) @map("migration_name")
  logs              String?
  rolledBackAt      Timestamptz? @map("rolled_back_at")
  startedAt         Timestamptz  @default(now()) @map("started_at")
  appliedStepsCount Int          @default(0) @map("applied_steps_count")

  @@map("_prisma_migrations")
}

model Project {
  id         String       @id(map: "project_pkey")
  businessId String
  imageUrl   String
  altText    String
  position   Int          @default(0)
  createdAt  Timestamp(3) @default(now())
  updatedAt  Timestamp(3)
  business   Business     @relation(fields: [businessId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "project_businessId_fkey")

  @@index([businessId], map: "project_businessId_idx")
  @@map("project")
}

model SharedReview {
  id              String           @id(map: "shared_review_pkey")
  text            String
  rating          Int
  reviewerName    String?
  userId          String
  createdAt       Timestamp(3)     @default(now())
  keywords        String?
  reviewAnalytics ReviewAnalytics?
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "shared_review_userId_fkey")

  @@index([userId], map: "shared_review_userId_idx")
  @@map("shared_review")
}

model ReviewAnalytics {
  id                String       @id(map: "review_analytics_pkey")
  reviewId          String
  visitCount        Int          @default(0)
  reviewCount       Int          @default(0)
  createdAt         Timestamp(3) @default(now())
  updatedAt         Timestamp(3)
  qrScanCount       Int          @default(0)
  redirectCount     Int          @default(0)
  aiCopyCount       Int          @default(0)
  platformRedirects Jsonb?       @default(dbgenerated("'{}'::jsonb"))
  review            SharedReview @relation(fields: [reviewId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "review_analytics_reviewId_fkey")

  @@index([reviewId], map: "review_analytics_reviewId_idx")
  @@unique([reviewId], map: "review_analytics_reviewId_key")
  @@map("review_analytics")
}

model Service {
  id          String       @id(map: "service_pkey")
  businessId  String
  icon        String
  title       String
  description String
  position    Int          @default(0)
  createdAt   Timestamp(3) @default(now())
  updatedAt   Timestamp(3)
  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "service_businessId_fkey")

  @@index([businessId], map: "service_businessId_idx")
  @@map("service")
}

model Session {
  id        String       @id(map: "session_pkey")
  expiresAt Timestamp(3)
  token     String
  createdAt Timestamp(3) @default(now())
  updatedAt Timestamp(3)
  ipAddress String?
  userAgent String?
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "session_userId_fkey")

  @@index([token], map: "session_token_key", unique: true)
  @@index([userId], map: "session_userId_idx")
  @@map("session")
}

model Task {
  id          String        @id(map: "task_pkey")
  title       String
  description String?
  column      String        @default("todo")
  priority    String        @default("medium")
  dueDate     Timestamp(3)?
  position    Int           @default(0)
  assigneeId  String
  businessId  String
  createdAt   Timestamp(3)  @default(now())
  updatedAt   Timestamp(3)
  assignee    User          @relation(fields: [assigneeId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "task_assigneeId_fkey")
  business    Business      @relation(fields: [businessId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "task_businessId_fkey", index: false)

  @@index([assigneeId], map: "task_assigneeId_idx")
  @@index([businessId, column], map: "task_businessId_column_idx")
  @@map("task")
}

model TeamMeeting {
  id          String       @id(map: "team_meeting_pkey")
  title       String
  date        Timestamp(3)
  startTime   String
  endTime     String
  location    String
  businessId  String
  createdAt   Timestamp(3) @default(now())
  updatedAt   Timestamp(3)
  meetSpaceId String?
  meetUri     String?
  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "team_meeting_businessId_fkey", index: false)

  @@index([businessId, date], map: "team_meeting_businessId_date_idx")
  @@map("team_meeting")
}

model TwoFactor {
  id                      String        @id(map: "twoFactor_pkey")
  secret                  String
  backupCodes             String
  userId                  String
  verified                Boolean?      @default(true)
  failedVerificationCount Int?          @default(0)
  lockedUntil             Timestamp(3)?
  user                    User          @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "twoFactor_userId_fkey")

  @@index([secret], map: "twoFactor_secret_idx")
  @@index([userId], map: "twoFactor_userId_idx")
  @@map("twoFactor")
}

model Verification {
  id         String       @id(map: "verification_pkey")
  identifier String
  value      String
  expiresAt  Timestamp(3)
  createdAt  Timestamp(3) @default(now())
  updatedAt  Timestamp(3)

  @@index([identifier], map: "verification_identifier_idx")
  @@map("verification")
}
